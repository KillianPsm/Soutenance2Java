<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="300.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="fr.cda.immobilier.controller.ModalMailController">
    <children>
        <Label layoutX="84.0" layoutY="84.0" text="Veuillez saisir l'adresse mail de l'expéditeur :"/>
        <TextField fx:id="enterEmail" layoutX="100.0" layoutY="138.0" prefHeight="25.0" prefWidth="200.0"
                   promptText="Adresse mail de l'epéditeur"/>
        <Button fx:id="sendMail" layoutX="126.0" layoutY="199.0" mnemonicParsing="false" onAction="#sendAMail"
                text="Envoyer"/>
        <Button fx:id="cancel" layoutX="217.0" layoutY="199.0" mnemonicParsing="false" onAction="#onCloseClick"
                text="Annuler"/>
    </children>
</AnchorPane>
